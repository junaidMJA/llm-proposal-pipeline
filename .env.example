# =============================================================================
# Environment configuration template. Copy to `.env` and fill in as needed.
#   cp .env.example .env
# Everything below is optional: the pipeline runs fully offline in CPU demo
# mode with zero secrets configured.
# =============================================================================

# Hugging Face access token for gated models (not required in CPU demo mode).
HF_TOKEN=

# Override the base model configured in config/training_config.yaml.
MODEL_NAME=unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit

# Execution mode: auto | gpu | cpu_demo
#   auto     -> auto-detect CUDA, otherwise fall back to CPU demo
#   gpu      -> force real Unsloth 4-bit QLoRA training (Linux + CUDA)
#   cpu_demo -> force hardware-demo simulation (runs end-to-end on any laptop)
EXECUTION_MODE=auto

# Optional OpenAI-compatible API key (e.g. OpenRouter) for hosted LLM inference.
# When set, inference prefers the hosted LLM. Otherwise it falls through to
# local weights (when present) and finally to the offline deterministic engine.
LLM_API_KEY=

# OpenAI-compatible endpoint and model identifiers.
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-8b-instruct